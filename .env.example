# =============================================================================
#  .env  —  configuration template
# =============================================================================
#
#  HOW TO USE
#    1. Copy this file:            cp .env.example .env
#                                 (Windows: copy .env.example .env)
#    2. Fill in the blank values.  Every value below is empty on purpose.
#    3. Confirm it loads:          npm run mcp:check
#       It prints the path it read and any keys still missing, and makes no
#       API calls, so it is safe to run before you have working credentials.
#
#  RULES
#    * .env is gitignored. NEVER commit it. It holds a live Jira API token
#      and an AgileTest client secret.
#    * Format:  KEY=value   - no quotes, no "export", no spaces around =.
#    * A blank value disables the feature it controls.
#    * Do not wrap values in quotes; the value is used exactly as typed.
#
#  REQUIRED vs OPTIONAL
#    The server refuses to start if a REQUIRED value is missing or blank, and
#    names the exact keys. OPTIONAL values degrade quietly.
#
#  Every example below is illustrative only. Replace them with your own.
# =============================================================================


# =============================================================================
#  JIRA  —  all required
# =============================================================================

# Site URL. Include the trailing slash.
#   Example:  https://yourteam.atlassian.net/
#   Self-hosted Jira uses a different host, e.g. https://jira.yourcompany.com/
JIRA_BASE_URL=

# Email address of the account that OWNS the API token. The token acts as this
# user, so this must be the account that created the token, not your own login
# if the token was created by someone else.
#   Example:  jane.doe@yourcompany.com
JIRA_EMAIL=

# Atlassian API token — NOT your account password.
#   Create one at:  <your JIRA_BASE_URL>/secure/settings/api-tokens
#   It is a long random string and is shown only once, so copy it immediately.
#   Leave blank here. Do not paste a real token into this file.
JIRA_API_TOKEN=

# Key of the Jira project that owns the stories and test cases. All caps.
#   Example:  PROJ
#   To find it: open a project in Jira; the key is in the URL, e.g.
#   /projects/PROJ/boards/123
JIRA_PROJECT_KEY=

# Default story the MCP tools act on when a call omits storyKey. You can always
# override this per call, so set it to whatever you are working on now.
#   Example:  PROJ-1234
JIRA_STORY_KEY=

# Name of the issue type used for test cases. Must match your Jira project
# EXACTLY, including capitalisation and spacing.
#   Example:  Test Case
#   If unsure, open an existing test case in Jira and read the type label.
#
#   This value is a safety guard: deletion only ever touches issues whose type
#   matches it, which is what stops a Story or Bug being deleted by mistake.
#   Check it carefully — a wrong value makes deletion a no-op.
JIRA_TESTCASE_ISSUETYPE_NAME=


# =============================================================================
#  AGILETEST  —  all required
# =============================================================================

# Client id from the AgileTest account settings.
#   Find it under your AgileTest profile / API credentials.
#   Leave blank here.
AGILETEST_CLIENT_ID=

# Client secret paired with the id above. Treat it like a password.
#   Leave blank here.
AGILETEST_CLIENT_SECRET=

# Numeric id of the AgileTest project. This is NOT the Jira project key —
# they are different numbers for different systems.
#   Example:  12345
#   Find it in the AgileTest URL when the project is open, e.g.
#   .../project/12345/...
AGILETEST_PROJECT_ID=


# =============================================================================
#  OPTIONAL  —  leave blank to use the behaviour noted
# =============================================================================

# Account id (not email) of the user new test cases are assigned to.
# Leave blank to skip assignment entirely.
#   Example:  5b10a2844c20165700ede21g
JIRA_ASSIGNEE_ACCOUNT_ID=

# Name of the issue link used to attach a test case to its story.
# Leave blank to use the built-in default:  AgileTest
JIRA_ISSUE_LINK_TYPE=

# Priority applied to newly created Jira test cases.
# Leave blank to let Jira apply the project default.
#   Example:  Medium
JIRA_TESTCASE_PRIORITY_NAME=


# =============================================================================
#  DEVELOPMENT ONLY
# =============================================================================

# Normally leave this blank. A long-running MCP process keeps its modules in
# memory, so if you edit the code and then call a tool, the process can still
# run the OLD version. The server fingerprints its own source and refuses to
# make changes when it detects that, telling you to restart instead.
#
# Setting this to 1 bypasses that protection. Only do it if you deliberately
# want the old behaviour, and never in a shared environment.
AGILETEST_ALLOW_STALE_CODE=
